# ── APIx Server ────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────────────
# MongoDB Atlas / Supabase free-tier connection string.
# Leave EMPTY to run with the built-in in-memory demo store.
MONGODB_URI=
MONGODB_DB=apix

# ── Scraper Engine ─────────────────────────────────────────────
# simulate  → deterministic stochastic generator (demo / CI, no network)
# live      → Playwright chromium adapters (requires: npx playwright install chromium)
SCRAPE_MODE=simulate
SCRAPE_API_KEY=apix-demo-key
SCRAPE_MIN_DELAY_MS=5000
SCRAPE_MAX_DELAY_MS=15000
# true → manual triggers outside 02:00–04:00 IST are rejected (compliance gate)
SCRAPE_OFF_PEAK_ONLY=false
# Daily off-peak cron (sec min hour * * *), 02:15 IST window
SCRAPE_CRON=0 15 2 * * *
# First N days of history are the index base period (APIx = 100)
BASELINE_DAYS=7
